# ============================================================
# 云夹 · 本地环境变量示例
# 复制为 .env 后修改。EdgeOne 部署时请在项目设置里逐项添加。
# ============================================================

# 管理员登录名（不填默认为 admin）
ADMIN_USERNAME=admin

# 管理员密码（必填）。也可以改用 ADMIN_PASSWORD_SHA256。
ADMIN_PASSWORD=change-me-to-a-long-random-password

# 可选：管理员密码的 SHA-256 十六进制摘要。
# 生成方式：node -e "console.log(require('crypto').createHash('sha256').update('你的密码').digest('hex'))"
# 配置后优先于 ADMIN_PASSWORD 使用。
# ADMIN_PASSWORD_SHA256=

# 会话签名密钥（生产环境必填，建议 64 位随机字符串）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# 管理员会话有效期（小时），默认 24
# SESSION_TTL_HOURS=24

# EdgeOne KV 绑定变量名。默认使用 CLIPBOARD_KV。
# 本项目会自动从全局变量或环境变量中查找该名称。
# CLIPBOARD_KV 由 EdgeOne 控制台绑定，无需填写值。
# 只有你在控制台使用了别的变量名时才需要设置：
# KV_BINDING_NAME=CLIPBOARD_KV

# 可选：仅本地开发使用，强制 Cookie 带 Secure 标记
# COOKIE_SECURE=true
